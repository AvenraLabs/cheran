# Production Environment Configuration for Cheran Backend
PORT=5000
NODE_ENV=production
DB_URI=postgres://postgres:password@localhost:5432/cheran
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_STATEMENT_TIMEOUT=30000
DB_IDLE_TX_TIMEOUT=30000
DB_SSL=false
MAX_FILE_SIZE_MB=50

# CORS: Comma-separated allowed origins (or * to allow all)
CORS_ORIGIN=https://ajay.cheranplast.in,https://cheranplast.in,http://localhost:3000,http://localhost:5173

JWT_SECRET=cheran_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=30d
